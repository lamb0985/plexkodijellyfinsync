# Plex Variables
PLEX_SERVER=
PLEX_TOKEN=
PLEX_MEDIA_ROOT=/data/media
PLEX_EXCLUDE_LIBRARIES=
# Kodi Variables
KODI_DB_USER=
KODI_DB_PASSWORD=
KODI_DB_HOST=
KODI_DB_PORT=3306
KODI_DB_NAME=
KODI_WEBUI_RPC=
KODI_WEBUI_RPC_USER=
KODI_WEBUI_RPC_PASSWORD=
KODI_MEDIA_ROOT=
# Jellyfin Variables
JELLYFIN_SERVER=
JELLYFIN_USER=
JELLYFIN_PW=
JELLYFIN_TOKEN=
JELLYFIN_USER_ID=
JELLYFIN_MEDIA_ROOT=/data/media
# Misc. Variables
SYNC_STATE_FILE=/config/.last_sync_state.json
SYNC_SCRIPT_FILE=/scripts/plexkodijellyfinsync.py
FLASK_SERVER_FILE=/scripts/flask-webhook.py
# Flask Webhook Server Variables
FLASK_WEBHOOK_SERVER=http://127.0.0.1:5000/
FLASK_PLEX_WEBHOOK=http://127.0.0.1:5000/plex
FLASK_SYNC=http://127.0.0.1:5000/sync
FLASK_CACHE_RESET=http://127.0.0.1:5000/cachereset
FLASK_STATUS=http://127.0.0.1:5000/status
FLASK_TRACKER=http://127.0.0.1:5000/tracker
FLASK_USERNAME=
FLASK_PASSWORD=

# Default .env file is provided in /app/config/.env-template, but needs to exist in /config to function (can run setup.py within container to populate)
# Default scripts (plexkodijellyfinsync.py and flask-webhook.py) are provided in /app/scripts, but need to exist in /scripts to function
# Singular '=' denotes a blank row in table when this info is displayed in logs
